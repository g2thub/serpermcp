{
  "name": "serpermcp",
  "version": "1.0.0",
  "description": "Local stdio MCP server for Serper web search and page scrape",
  "type": "module",
  "bin": {
    "serpermcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g2thub/serpermcp.git"
  },
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('dist/index.js', 0o755)\"",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
